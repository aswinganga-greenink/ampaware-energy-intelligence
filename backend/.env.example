# =============================================================================
# AmpAware Backend — Environment Configuration Template
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_NAME=AmpAware
APP_ENV=development                   # development | staging | production
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-me-to-a-64-char-random-secret
ALLOWED_HOSTS=*

# --- API ---
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ampaware
POSTGRES_USER=ampaware_user
POSTGRES_PASSWORD=change-me-postgres-password
# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO_SQL=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me-redis-password
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=5

# --- JWT Authentication ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Telemetry Ingestion ---
TELEMETRY_MAX_FUTURE_SECONDS=60        # reject readings > 60s in the future
TELEMETRY_MAX_PAST_SECONDS=86400       # reject readings > 24h in the past
TELEMETRY_DEDUP_WINDOW_SECONDS=5       # deduplicate identical packets within 5s

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json                        # json | pretty
LOG_FILE_PATH=logs/ampaware.log
LOG_ROTATION_BYTES=10485760            # 10 MB
LOG_BACKUP_COUNT=5

# --- APScheduler ---
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_COALESCE=true
SCHEDULER_MAX_INSTANCES=3

# --- OpenTelemetry (optional) ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ampaware-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_TELEMETRY_PER_MINUTE=600   # high-frequency device ingestion

# --- Pagination ---
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
